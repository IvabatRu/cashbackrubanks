# Скопируй этот файл в .env.local и подставь свои значения.
# .env.local в git не попадает (он в .gitignore).
#
# Где взять: панель Supabase → Project Settings → API.
# Подробно — в SYNC-SETUP.md.
#
# Без этих переменных приложение работает как обычное локальное,
# просто раздел «Синхронизация» будет выключен.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
